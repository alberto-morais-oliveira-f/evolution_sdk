{
    "name": "am2tec/evolution-sdk",
    "version": "1.1.2",
    "description": "Laravel SDK for Evolution API (WhatsApp gateway).",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Am2tec\\EvolutionSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Am2tec\\EvolutionSdk\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Alberto Morais",
            "email": "albertomorais80@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Am2tec\\EvolutionSdk\\Providers\\EvolutionServiceProvider"
            ],
            "aliases": {
                "Evolution": "Am2tec\\EvolutionSdk\\Facades\\Evolution"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    }
}
